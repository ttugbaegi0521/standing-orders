# Copy to .env and fill in. Never commit real values.

# Postgres connection string; must point at an empty database the first time you migrate.
DATABASE_URL=postgres://localhost:5432/standing_orders
# Public base URL of the app, used to build tier-2 approval links.
APP_BASE_URL=http://localhost:3000
# PayPal sandbox REST app client id (developer.paypal.com → Apps & Credentials, Sandbox).
PAYPAL_CLIENT_ID=
# PayPal sandbox REST app secret.
PAYPAL_CLIENT_SECRET=
# Channel3 API key for product search and prices.
CHANNEL3_API_KEY=
# Channel3 base URL. Default: https://api.trychannel3.com
CHANNEL3_API_BASE=
# Anthropic API key for the parse, score, and decide steps.
ANTHROPIC_API_KEY=
# Demo safety: when true, step 5 refuses to buy anything flagged as a fake sale. Defaults to off.
DEMO_SAFETY=false
# Merchant names (comma-separated) that support agent checkout: tier 1, vaulted auto-capture.
# Every other merchant is tier 2 (one-tap approval link). Example: standing-orders-sandbox-store
# Leaving this empty forces tier 2 for ALL merchants, so no Vault is needed (use this when the sandbox
# blocks Vault setup). `npm run workflow:smoke` requires it to be empty.
AGENT_READY_MERCHANTS=
# 32-byte key that encrypts PayPal vault tokens at rest (AES-256-GCM). Generate: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=
# Stand-in for "me" in /api/users/me/* until real auth exists: the seeded demo user.
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
# Live by default: with ANTHROPIC_API_KEY set, creating an order parses it with real Claude (check-now and the tick
# always run live and answer 503 without ANTHROPIC_API_KEY and CHANNEL3_API_KEY). Fixtures are used only without a
# key and in tests. Set USE_LIVE_MODEL=false to force the fixture parser even with a key. `npm run workflow:smoke`
# (the seeded demo) is opt-in instead: set USE_LIVE_MODEL=true there to use real Claude for scoring and decide;
# unset means fixtures.
# USE_LIVE_MODEL=
# Only `npm run workflow:smoke` reads this: set USE_LIVE_CHANNEL3=true to search real Channel3 (needs CHANNEL3_API_KEY)
# in the seeded demo; unset means fixture products. The web app and tick are always live.
# USE_LIVE_CHANNEL3=
# Watch loop (POST /api/tick, npm run tick): minutes before an order that held, was skipped or errored is checked again. Default 60.
HOLD_RECHECK_MINUTES=60
# Most orders one tick processes. Default 10.
TICK_BATCH_LIMIT=10
# If set, POST /api/tick requires "Authorization: Bearer <this value>". Set it anywhere the app is reachable by others.
TICK_SECRET=
# The kill switch is stored on the user (users.kill_switch) and flipped from the dashboard or POST /api/kill-switch;
# there is no env setting. While it is on, the watch loop (tick and check-now) records any proposed purchase as a
# blocked decision and creates no PayPal order.
