# Copy to .env and fill in. Never commit real values.

# Postgres connection string; must point at an empty database the first time you migrate.
DATABASE_URL=postgres://localhost:5432/standing_orders
# Public base URL of the app, used to build tier-2 approval links.
APP_BASE_URL=http://localhost:3000
# PayPal sandbox REST app client id (developer.paypal.com → Apps & Credentials, Sandbox).
PAYPAL_CLIENT_ID=
# PayPal sandbox REST app secret.
PAYPAL_CLIENT_SECRET=
# Channel3 API key for product search and prices.
CHANNEL3_API_KEY=
# Channel3 base URL. Default: https://api.trychannel3.com
CHANNEL3_API_BASE=
# Anthropic API key for the parse, score, and decide steps.
ANTHROPIC_API_KEY=
# Demo safety: when true, step 5 refuses to buy anything flagged as a fake sale. Defaults to off.
DEMO_SAFETY=false
# Merchant names (comma-separated) that support agent checkout: tier 1, vaulted auto-capture.
# Every other merchant is tier 2 (one-tap approval link). Example: standing-orders-sandbox-store
# Leaving this empty forces tier 2 for ALL merchants, so no Vault is needed (use this when the sandbox
# blocks Vault setup). `npm run workflow:smoke` requires it to be empty.
AGENT_READY_MERCHANTS=
# 32-byte key that encrypts PayPal vault tokens at rest (AES-256-GCM). Generate: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=
# Stand-in for "me" in /api/users/me/* until real auth exists: the seeded demo user.
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
# true makes the scoring and decide steps of `npm run workflow:smoke`, and the parse step of POST /api/orders, use the real Claude model (needs ANTHROPIC_API_KEY); false uses fixtures (the fixture parser only knows the two seeded intents).
USE_LIVE_MODEL=false
# true makes `npm run workflow:smoke` search real Channel3 (needs CHANNEL3_API_KEY); false uses the fixture products.
USE_LIVE_CHANNEL3=false
