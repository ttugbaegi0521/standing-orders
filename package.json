{
  "name": "standing-orders",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts",
    "paypal:smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/paypal-smoke.ts",
    "vault:smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/vault-smoke.ts",
    "workflow:smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/workflow-smoke.ts",
    "channel3:smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/channel3-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.97",
    "ai": "7.0.163",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
